# Connection to the local qBittorrent WebUI
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin
# Set to false only if you use a self signed certificate
QBITTORRENT_VERIFY_SSL=true
# Per request timeout (seconds) for qBittorrent API calls
QBITTORRENT_TIMEOUT=30

# How long a single search may run before we give up (seconds)
GETFLIX_SEARCH_TIMEOUT=45
# Maximum number of search results rendered in the UI
GETFLIX_MAX_RESULTS=50
# Minimum fuzzy match score (0-100) required for a result to be listed.
# Set to 0 to list every result that has at least one seeder.
GETFLIX_MIN_SCORE=45
# Number of hours a torrent is allowed to seed before qBittorrent stops it
GETFLIX_SEED_HOURS=24
# Optional: default save path used when adding torrents
# GETFLIX_SAVE_PATH=/home/user/Downloads/getflix
# Optional: qBittorrent category applied to torrents added through Getflix
# GETFLIX_CATEGORY=movies
# Optional: comma separated qBittorrent tags
GETFLIX_TAGS=getflix
# Optional: only show results in these qBittorrent search categories.
# Empty means "do not filter by category".
# GETFLIX_CATEGORIES=movies,tv,television,series,video

# Where the finished downloads live. Clicking a completed download streams
# the file from here, the Docker stack mounts it at /data.
# GETFLIX_DOWNLOAD_ROOT=/data
# Only needed when Getflix runs on the host and qBittorrent in a container:
# the directory qBittorrent reports its files in.
# GETFLIX_QBITTORRENT_DOWNLOAD_ROOT=/data
# Completed downloads link with a vlc: URL so one click opens VLC. Install the
# handler with "make vlc-handler", or set this to false to link the .m3u
# playlist instead.
# GETFLIX_VLC_URL_SCHEME=true

# Getflix web server
GETFLIX_HOST=127.0.0.1
GETFLIX_PORT=5000
GETFLIX_DEBUG=false
# Optional: fixed Flask session secret. Generated at random on each start if unset,
# which is fine for local use but invalidates sessions on restart.
# GETFLIX_SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Docker stack (docker compose up -d)
#
# The values below are read by docker-compose.yml, they are not used when
# Getflix runs directly on the host.
# ---------------------------------------------------------------------------

# --- qBittorrent credentials -----------------------------------------------
# The WebUI password is written into the qBittorrent configuration before
# the first start, so that Getflix can talk to the API.
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# --- published ports --------------------------------------------------------
# Interface the ports are bound to. 127.0.0.1 keeps them private, use
# 0.0.0.0 to reach them from the network - and only with a VPN in place.
QBITTORRENT_WEBUI_BIND=127.0.0.1
QBITTORRENT_WEBUI_PORT=8080
GETFLIX_BIND_ADDRESS=127.0.0.1
GETFLIX_PORT=5000

# --- ownership --------------------------------------------------------------
# The user and group the qBittorrent files are owned by.
PUID=1000
PGID=1000

# --- network ----------------------------------------------------------------
# Subnet of the compose network. It is also the range that may talk to the
# qBittorrent WebUI without a password, change it if it clashes with a
# network on the host.
GETFLIX_DOCKER_SUBNET=172.28.0.0/16
# Set to an empty value to require the password everywhere.
# QBITTORRENT_AUTH_SUBNET=

# --- VPN --------------------------------------------------------------------
# Set to "no" to run qBittorrent without a VPN. Only useful for testing.
VPN_ENABLED=yes
# openvpn | wireguard
VPN_CLIENT=openvpn
# pia | airvpn | protonvpn | custom
VPN_PROV=custom
VPN_USER=
VPN_PASS=
# OpenVPN: the server address, for example "nl.privacy.network".
# WireGuard: the name of the .conf file in config/qbittorrent/wireguard/.
VPN_REMOTE_SERVER=
# Extra options passed to the OpenVPN client.
VPN_OPTIONS=
# Ask the provider for a port forwarding (PIA and ProtonVPN only).
STRICT_PORT_FORWARD=no
# Name servers used inside the container. The killswitch blocks DNS lookups
# that do not go through the tunnel.
NAME_SERVERS=1.1.1.1,1.0.0.1
# REQUIRED while the VPN is enabled, the container exits without it.
# The subnet of your LAN. Find it on the docker host with:
#   ip -o -4 addr show scope global
LAN_NETWORK=192.168.1.0/24
# Print the debug output of the binhex scripts.
QBITTORRENT_DEBUG=false
